{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Agent Switch",
  "version": "0.4.0",
  "identifier": "com.codexagentswitch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Agent Switch",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/cas-helper"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
