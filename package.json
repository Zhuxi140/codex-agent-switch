{
  "name": "codex-agent-switch",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:bundle": "npm run build && npm run prepare:sidecar",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "bundle:windows": "tauri build --bundles nsis",
    "e2e:orchestration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rc1-native-orchestration-e2e.ps1",
    "e2e:orchestration:matrix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rc1-native-orchestration-e2e.ps1 -Stage RC2",
    "e2e:runtime-recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rc1-native-orchestration-e2e.ps1 -Stage PHASE6",
    "poc:app-server": "node scripts/cas-app-server-poc.mjs",
    "poc:app-server:self-test": "node scripts/cas-app-server-poc.mjs --self-test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
